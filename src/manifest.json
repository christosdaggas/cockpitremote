{
  "version": 0,
  "requires": {
    "cockpit": "266"
  },
  "tools": {
    "index": {
      "label": "Remote Desktop",
      "path": "index.html",
      "keywords": [
        {
          "matches": ["vnc", "remote", "desktop", "screen", "novnc"]
        }
      ]
    }
  },
  "content-security-policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
}
